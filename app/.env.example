NEXT_PUBLIC_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Program ID (deployed via arcium deploy)
NEXT_PUBLIC_PROGRAM_ID=PrivPerps1111111111111111111111111111111111

# Arcium cluster offset for devnet
NEXT_PUBLIC_CLUSTER_OFFSET=456

# Jupiter Price API (public, no key needed)
NEXT_PUBLIC_PRICE_API=https://api.jup.ag/price/v2
